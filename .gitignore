# ============================================================
#  WASM Game Hub — React/Vite frontend + C++ (Emscripten) backend
# ============================================================

# --- Dependencies -------------------------------------------
node_modules/

# --- Frontend build output (Vite) ---------------------------
dist/
dist-ssr/
*.local
.vite/
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# --- TypeScript ---------------------------------------------
*.tsbuildinfo

# --- Backend build output (C++ / Emscripten) ----------------
# NOTE: backend/build.sh writes the compiled engine to
# public/wasm/games.js. It is deliberately NOT ignored, because
# build-all.sh falls back to this prebuilt file when em++ isn't
# installed. If everyone on your team has Emscripten, you can
# ignore it instead by uncommenting the next line:
# public/wasm/

# Stray Emscripten / compiler intermediates
*.wasm
*.wasm.map
*.o
*.obj
*.a
*.bc
*.d
*.out
backend/build/
backend/out/

# Emscripten SDK, if cloned inside the project
emsdk/
.emscripten_cache/
.emscripten_ports/

# --- Environment & secrets ----------------------------------
.env
.env.*
!.env.example

# --- Logs ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Package manager extras (keep package-lock.json) --------
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
.npm/

# --- Test / coverage ----------------------------------------
coverage/
.nyc_output/

# --- Editors & IDEs -----------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- OS files -----------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
